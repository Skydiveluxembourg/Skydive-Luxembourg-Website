---
// Reviews stay on Google; this section provides only the external link.
const { cta = 'Read our reviews on Google', url = '#' } = Astro.props;
---

<div class="google-rating" data-google-reviews-status="link-only">
  <a class="btn btn--outline" href={url} target="_blank" rel="noopener noreferrer">{cta}</a>
</div>

<style>
  .google-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
</style>
