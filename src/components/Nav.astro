---
/**
 * Nav.astro - main site navigation.
 * Self-contained: translations, styles, mobile toggle, language switcher.
 * Used inside Layout.astro.
 *
 * NOTE: "Find us" page was merged into "Contact" - location info and the
 *       contact form now live on the same page.
 */

import { Image } from 'astro:assets';

import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { pageHref } from '../utils/urls.js';

import logoBlack from '../assets/logo/skydive-logo-black.png';
import logoWhite from '../assets/logo/skydive-logo-white.png';

const lang = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname;

// "Book a tandem" lands on the tandem page's booking section, which offers
// the three dz-cloud options (buy with a date, gift card, redeem a gift card).
const bookHref = pageHref(`/${lang}/tandem#book`);

const labels = {
  en: {
    about: 'About', news: 'News', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Fun jumpers', pricing: 'Pricing',
    gallery: 'Gallery', faq: 'FAQ', contact: 'Contact',
    menu: 'Menu',
    book: 'Book a tandem', bookShort: 'Book',
  },
  fr: {
    about: 'À propos', news: 'Actualités', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Parachutistes confirmés', pricing: 'Tarifs',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Contact',
    menu: 'Menu',
    book: 'Réserver un tandem', bookShort: 'Réserver',
  },
  de: {
    about: 'Über uns', news: 'Neuigkeiten', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Sportspringer', pricing: 'Preise',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Kontakt',
    menu: 'Menü',
    book: 'Tandem buchen', bookShort: 'Buchen',
  },

  lu: {
    about: 'Iwwer eis', news: 'Neiegkeeten', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Sportsprénger', pricing: 'Präisser',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Kontakt',
    menu: 'Menü',
    book: 'Tandem buchen', bookShort: 'Buchen',
  },
};

const t = labels[lang] ?? labels.en;

const items = [
  ['about',       t.about],
  ['news',        t.news],
  ['tandem',      t.tandem],
  ['aff',         t.aff],
  ['fun-jumpers', t.funJumpers],
  ['pricing',     t.pricing],
  ['gallery',     t.gallery],
  ['faq',         t.faq],
  ['contact',     t.contact],
];

const isActive = (slug) => {
  const target = `/${lang}/${slug}`;
  return path === target || path.startsWith(target + '/');
};
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav__inner">

    <a href={`/${lang}/`} class="site-nav__logo" aria-label="Skydive Luxembourg home">
      <Image
        src={logoBlack}
        alt=""
        class="site-nav__logo-img site-nav__logo-img--black"
        width={180}
        height={89}
        loading="eager"
      />
      <Image
        src={logoWhite}
        alt=""
        class="site-nav__logo-img site-nav__logo-img--white"
        width={180}
        height={90}
        loading="eager"
      />
    </a>

    <div class="site-nav__menu" id="site-nav-menu" data-nav-list>
      <ul class="site-nav__list">
        {items.map(([slug, label]) => (
          <li>
            <a
              href={pageHref(`/${lang}/${slug}`)}
              class:list={['site-nav__link', { 'is-active': isActive(slug) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav__utilities">
        <LanguageSwitcher />
        <ThemeToggle />
      </div>
    </div>

    <div class="site-nav__actions">
      <a
        href={bookHref}
        class="btn btn--primary site-nav__book"
      >
        <span class="site-nav__book-full">{t.book}</span>
        <span class="site-nav__book-short">{t.bookShort}</span>
      </a>
    </div>

    <button
      class="site-nav__toggle"
      type="button"
      aria-label={t.menu}
      aria-expanded="false"
      aria-controls="site-nav-menu"
      data-nav-toggle
    >
      <span class="site-nav__toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="site-nav__toggle-label">{t.menu}</span>
    </button>

  </div>
</nav>

<script>
  // Mobile menu toggle - vanilla JS, runs on every page load
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const toggle = document.querySelector('[data-nav-toggle]');
  const list = document.querySelector('[data-nav-list]');

  let navHeight = 0;
  const setNavHeight = (height: number) => {
    if (height <= 0 || height === navHeight) return;
    navHeight = height;
    document.documentElement.style.setProperty('--site-nav-height', `${height}px`);
  };

  if ('ResizeObserver' in window && nav) {
    // The observer supplies dimensions after layout, avoiding a forced startup read.
    new ResizeObserver(([entry]) => {
      const borderBox = entry.borderBoxSize?.[0];
      setNavHeight(borderBox?.blockSize ?? nav.offsetHeight);
    }).observe(nav, { box: 'border-box' });
  } else if (nav) {
    // Older browsers measure after the initial render and once per resize frame.
    let frame = 0;
    const scheduleNavHeight = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        setNavHeight(nav.offsetHeight);
      });
    };
    scheduleNavHeight();
    window.addEventListener('resize', scheduleNavHeight);
    nav.querySelectorAll('img').forEach((image) => {
      image.addEventListener('load', scheduleNavHeight);
    });
  }

  const closeMenu = () => {
    list?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = list?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  list?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-nav {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-nav__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-2) max(var(--space-4), env(safe-area-inset-right)) var(--space-1) max(var(--space-4), env(safe-area-inset-left));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas:
      "brand utilities booking"
      "links links links";
    align-items: center;
    gap: var(--space-2) var(--space-5);
    position: relative;
  }

  .site-nav__logo {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-nav__logo-img {
    display: block;
    width: 148px;
    height: auto;
  }

  .site-nav__logo-img--white { display: none; }

  :global(:root[data-theme="dark"]) .site-nav__logo-img--black { display: none; }
  :global(:root[data-theme="dark"]) .site-nav__logo-img--white { display: block; }

  .site-nav__toggle {
    display: none;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    cursor: pointer;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-fg);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    flex-shrink: 0;
  }
  .site-nav__toggle-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .site-nav__toggle-icon span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: var(--transition-fast);
  }

  .site-nav__menu {
    /* Keep one set of links and controls: CSS places them in separate desktop
       rows, and the same elements form the expanded menu on smaller screens. */
    display: contents;
  }

  .site-nav__utilities {
    grid-area: utilities;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-nav__list {
    grid-area: links;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-1);
    flex-wrap: nowrap;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-1);
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-2);
    color: var(--color-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .site-nav__link:hover { background: var(--color-bg-alt); }
  .site-nav__link.is-active {
    background: var(--color-blue);
    color: #FFFFFF;
  }

  /* ---------- persistent action: Book a tandem ------------------------- */

  .site-nav__actions {
    grid-area: booking;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .site-nav__book {
    padding: var(--space-2) var(--space-4);
    min-height: 44px; /* comfortable touch target, matches the nav toggle */
    font-size: var(--fs-base);
    white-space: nowrap;
  }

  /* The dedicated control row has room for the complete booking label. */
  .site-nav__book-full { display: inline; }
  .site-nav__book-short { display: none; }

  /* Tablet & mobile — collapse the nav links into the labelled menu. The bar then
     holds only logo + Book + toggle, so we surface the full booking label. */
  @media (max-width: 900px) {
    .site-nav__inner {
      display: flex;
      padding-block: var(--space-3);
      gap: var(--space-4);
    }
    .site-nav__logo-img { width: clamp(140px, 16vw, 190px); }
    .site-nav__toggle { display: flex; }
    .site-nav__actions { margin-left: auto; }
    .site-nav__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      max-height: calc(100vh - var(--site-nav-height, 100px));
      max-height: calc(100dvh - var(--site-nav-height, 100px));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-4) max(var(--space-4), env(safe-area-inset-right)) max(var(--space-4), env(safe-area-inset-bottom)) max(var(--space-4), env(safe-area-inset-left));
      gap: var(--space-3);
    }
    .site-nav__menu.is-open { display: flex; }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
      width: 100%;
      border-top: 0;
      padding-top: 0;
    }
    .site-nav__link {
      justify-content: flex-start;
      padding: var(--space-3);
      white-space: normal;
    }

    .site-nav__book-full { display: inline; }
    .site-nav__book-short { display: none; }
  }

  /* Small phones — go back to the short "Book" label and tighten spacing so
     logo + Book + hamburger never crowd the bar. */
  @media (max-width: 560px) {
    .site-nav__inner { gap: var(--space-2); }
    .site-nav__actions { gap: var(--space-1); }
    .site-nav__book { padding: var(--space-2) var(--space-3); }
    .site-nav__logo-img { width: clamp(112px, 34vw, 150px); }

    .site-nav__book-full { display: none; }
    .site-nav__book-short { display: inline; }
  }

  @media (max-width: 380px) {
    .site-nav__logo-img { width: clamp(96px, 30vw, 112px); }
    .site-nav__book { padding-inline: var(--space-2); }
    .site-nav__toggle { gap: var(--space-1); font-size: var(--fs-sm); }
  }
</style>
