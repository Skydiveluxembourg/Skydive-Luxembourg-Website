    aboutText: "Founded in 1965 as the Cercle Parachutiste Luxembourgeois, Skydive Luxembourg is a non-profit skydiving club. Our home is Noertrange airfield, near Wiltz in northern Luxembourg.",
    aboutCta: 'Read our story',

    ctaTitle: 'Ready when you are.',
    ctaSubtitle: "Explore the tandem experience and booking options, or ask us about learning to skydive.",
    ctaPrimary: 'Book a tandem',
    ctaSecondary: 'Contact us',
  },

  fr: {
    newsCta: "Actualités et vie du club",
    heroEyebrow: 'Skydive Luxembourg a.s.b.l.',
    heroTitle: "Parachutisme au Luxembourg.",
    heroSubtitle: "Sauts en tandem, formation AFF et parachutisme sportif à l’aérodrome de Noertrange, près de Wiltz. Notre passion commune depuis 1965.",
    heroPrimary: 'Réserver un tandem',
    heroSecondary: 'Apprendre à sauter',

    pickEyebrow: 'Trois façons de sauter',
    pickTitle: "Du premier saut au parachutisme sportif.",
    pickLead: "Découvrez le saut en tandem, la formation AFF ou les informations pour préparer votre venue comme parachutiste confirmé. Contactez-nous à",

    cards: [
      { title: 'Sauts en tandem', text: "Découvrez le saut en tandem, du briefing au vol sous voile. Consultez les conditions et les options de réservation.", cta: 'Découvrir le tandem', href: `/${''}fr/tandem` },
      { title: 'AFF - apprendre à sauter', text: "La formation Accelerated Freefall vous initie à la chute libre et au vol sous voile. Découvrez le déroulement du stage et renseignez-vous sur les prochaines dates.", cta: 'Découvrir l\'AFF', href: `/${''}fr/aff` },
      { title: 'Parachutistes confirmés', text: "Déjà breveté ? Retrouvez les conditions de saut, les infrastructures de la dropzone et les contacts pour le coaching avant votre visite à Noertrange.", cta: 'Visiter la DZ', href: `/${''}fr/fun-jumpers` },
    ],

    galleryEyebrow: 'En vol',
    galleryTitle: 'Quelques instants vus d\'en haut.',
    galleryCta: 'Voir toute la galerie',

    aboutEyebrow: 'À propos',
    aboutTitle: 'Une association à but non lucratif, gérée par et pour les parachutistes.',
    aboutText: "Fondé en 1965 sous le nom de Cercle Parachutiste Luxembourgeois, Skydive Luxembourg est un club de parachutisme sans but lucratif. Nous sommes basés à l’aérodrome de Noertrange, près de Wiltz, dans le nord du Luxembourg.",
    aboutCta: 'Notre histoire',

    ctaTitle: 'Prêt quand vous l\'êtes.',
    ctaSubtitle: "Découvrez le saut en tandem et les options de réservation, ou contactez-nous pour apprendre à sauter.",
    ctaPrimary: 'Réserver un tandem',
    ctaSecondary: 'Nous contacter',
  },

  de: {
    newsCta: "Neuigkeiten und Vereinsleben",
    heroEyebrow: 'Skydive Luxembourg a.s.b.l.',
    heroTitle: "Fallschirmspringen in Luxemburg.",
    heroSubtitle: "Tandemsprünge, AFF-Ausbildung und Fallschirmsport am Flugplatz Noertrange bei Wiltz. Seit 1965 teilen wir unsere Begeisterung fürs Springen.",
    heroPrimary: 'Tandem buchen',
    heroSecondary: 'Springen lernen',

    pickEyebrow: 'Drei Arten zu springen',
    pickTitle: "Vom ersten Sprung zum Fallschirmsport.",
    pickLead: "Entdecke den Tandemsprung, informiere dich zur AFF-Ausbildung oder plane deinen Besuch als erfahrener Springer. Kontakt:",

    cards: [
      { title: 'Tandemsprünge', text: "Entdecke den Tandemsprung vom Briefing bis zum Schirmflug. Informiere dich über Voraussetzungen und Buchungsoptionen.", cta: 'Mehr zum Tandem', href: `/${''}de/tandem` },
      { title: 'AFF - Sprungausbildung', text: "Unsere Accelerated-Freefall-Ausbildung führt dich an Freifall und Schirmflug heran. Informiere dich zum Ablauf und frage nach den nächsten Terminen.", cta: 'Mehr zu AFF', href: `/${''}de/aff` },
      { title: 'Sportspringer', text: "Schon lizenziert? Hier findest du Sprungvoraussetzungen, Einrichtungen der Dropzone und Coaching-Kontakte für deinen Besuch in Noertrange.", cta: 'DZ besuchen', href: `/${''}de/fun-jumpers` },
    ],

    galleryEyebrow: 'In der Luft',
    galleryTitle: 'Ein paar Momente von oben.',
    galleryCta: 'Zur Galerie',

    aboutEyebrow: 'Über uns',
    aboutTitle: 'Ein gemeinnütziger Verein - von Springern, für Springer.',
    aboutText: "1965 als Cercle Parachutiste Luxembourgeois gegründet, ist Skydive Luxembourg ein gemeinnütziger Fallschirmsportverein. Unser Zuhause ist der Flugplatz Noertrange bei Wiltz im Norden Luxemburgs.",
    aboutCta: 'Unsere Geschichte',

    ctaTitle: 'Bereit, wenn du es bist.',
    ctaSubtitle: "Informiere dich über Tandemsprünge und Buchungsoptionen oder frage uns nach der Sprungausbildung.",
    ctaPrimary: 'Tandem buchen',
    ctaSecondary: 'Kontakt',
  },

  lu: {
    newsCta: "Neiegkeeten a Veräinsliewen",
    heroEyebrow: 'Skydive Luxembourg a.s.b.l.',
    heroTitle: "Fallschiermsprangen zu Lëtzebuerg.",
    heroSubtitle: "Tandemspréng, AFF-Ausbildung a Fallschiermsport op der Fluchplaz Noertrange bei Wolz. Zënter 1965 deele mir eis Freed um Sprangen.",
    heroPrimary: 'Tandem buchen',
    heroSecondary: 'Sprange léieren',

    pickEyebrow: 'Drei Arten zu springen',
    pickTitle: "Vum éischte Sprong zum Fallschiermsport.",
    pickLead: "Entdeck den Tandemsprong, informéier dech iwwer d’AFF-Ausbildung oder plang däi Besuch als erfuerene Sprénger. Kontakt:",

    cards: [
      { title: 'Tandemspréng', text: "Entdeck den Tandemsprong vum Briefing bis zum Schiermfluch. Informéier dech iwwer d’Viraussetzungen an d’Reservatiounsméiglechkeeten.", cta: 'Mehr zum Tandem', href: `/${''}de/tandem` },
      { title: 'AFF - Sprongausbildung', text: "Eis Accelerated-Freefall-Ausbildung féiert dech un de fräie Fall an de Schiermfluch erun. Informéier dech iwwer den Oflaf a fro no den nächsten Datumer.", cta: 'Mehr zu AFF', href: `/${''}de/aff` },
      { title: 'Sportsprénger', text: "Scho lizenzéiert? Hei fënns du Sprongviraussetzungen, d’Ariichtunge vun der Dropzone a Coaching-Kontakter fir däi Besuch zu Noertrange.", cta: 'DZ besuchen', href: `/${''}de/fun-jumpers` },
    ],

    galleryEyebrow: 'In der Luft',
    galleryTitle: 'Ein paar Momente vu oben.',
    galleryCta: 'Zur Galerie',

    aboutEyebrow: 'Iwwer eis',
    aboutTitle: 'Ein gemeinnütziger Veräin - vu Spréngern, fir Sprénger.',
    aboutText: "1965 als Cercle Parachutiste Luxembourgeois gegrënnt, ass Skydive Luxembourg e Fallschiermsveräin ouni Gewënnzweck. Eist Doheem ass d’Fluchplaz Noertrange bei Wolz am Norde vu Lëtzebuerg.",
    aboutCta: 'Eis Geschicht',

    ctaTitle: 'Bereit, wenn du es bist.',
    ctaSubtitle: "Informéier dech iwwer Tandemspréng a Reservatiounsméiglechkeeten oder fro eis no der Sprongausbildung.",
    ctaPrimary: 'Tandem buchen',
    ctaSecondary: 'Kontakt',
  },
}[lang];

// Rewrite card hrefs to active locale
t.cards = t.cards.map((c) => ({
  ...c,
  href: c.href.replace(/^\/(en|fr|de|lu)\//, `/${lang}/`),
}));

const tandemHref = `/${lang}/tandem`;
const bookHref = `/${lang}/tandem#book`;
const aboutHref = `/${lang}/about`;
const contactHref = `/${lang}/contact`;
const galleryHref = `/${lang}/gallery`;
const affHref = `/${lang}/aff`;
const newsHref = `/${lang}/news`;

const galleryAlt = {
  en: [
    'Skydivers in freefall above Luxembourg',
    'Tandem skydive exit from the aircraft',
    'Open parachute over the dropzone',
    'Skydivers preparing for a jump',
    'Canopy flight over the Luxembourg countryside',
    'Skydive Luxembourg aircraft and jumpers',
  ],
  fr: [
    'Parachutistes en chute libre au-dessus du Luxembourg',
    'Sortie avion pour un saut en tandem',
    'Parachute ouvert au-dessus de la DZ',
    'Parachutistes en préparation avant le saut',
    'Vol sous voile au-dessus de la campagne luxembourgeoise',
    'Avion et parachutistes de Skydive Luxembourg',
  ],
  de: [
    'Fallschirmspringer im freien Fall über Luxemburg',
    'Tandemsprung beim Ausstieg aus dem Flugzeug',
    'Geöffneter Fallschirm über der Dropzone',
    'Fallschirmspringer bei der Vorbereitung vor dem Sprung',
    'Schirmflug über der luxemburgischen Landschaft',
    'Flugzeug und Springer von Skydive Luxembourg',
  ],

  lu: [
    'Fallschirmspringer im fräie Fall iwwer Lëtzebuerg',
    'Tandemsprong beim Ausstieg aus dem Fliger',
    'Geöffneter Fallschirm iwwer der Dropzone',
    'Fallschirmspringer bei der Vorbereitung vor dem Sprong',
    'Schirmflug iwwer der luxemburgischen Landschaft',
    'Fliger an Sprénger vu Skydive Luxembourg',
  ],
}[lang];

const galleryImages = [g1, g2, g3, g4, g5, g6];
const gallery = galleryImages.map((image, index) => ({
  image,
  alt: galleryAlt[index],
}));

// Attach images to cards
t.cards[0].image = tandemImg;
t.cards[0].alt = t.cards[0].title;
t.cards[1].image = affImg;
t.cards[1].alt = t.cards[1].title;
t.cards[2].image = funImg;
t.cards[2].alt = t.cards[2].title;

const reviews = await getGoogleReviews(lang);
---

<Hero
  image={heroImg}
  alt="Skydiver in freefall above Luxembourg"
  eyebrow={t.heroEyebrow}
  title={t.heroTitle}
  subtitle={t.heroSubtitle}
  primaryCta={{ label: t.heroPrimary, href: bookHref }}
  secondaryCta={{ label: t.heroSecondary, href: affHref }}
/>

<section class="section">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.pickEyebrow}</p>
      <h2 class="section__title">{t.pickTitle}</h2>
      <p class="section__lead">{t.pickLead} <a href="mailto:mail@skydive.lu">mail@skydive.lu</a></p>
    </header>
    <FeatureCards items={t.cards} />
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.aboutEyebrow}</p>
      <h2 class="section__title">{t.aboutTitle}</h2>
      <p class="section__lead">{t.aboutText}</p>
      <p style="margin-top: var(--space-6)">
        <a href={pageHref(aboutHref)} class="btn btn--outline">{t.aboutCta}</a>
      </p>
      <p style="margin-top: var(--space-4)">
        <a href={pageHref(newsHref)}>{t.newsCta}</a>
      </p>
    </header>
  </div>
</section>

<section class="section">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.galleryEyebrow}</p>
      <h2 class="section__title">{t.galleryTitle}</h2>
    </header>
    <Gallery items={gallery} />
    <p style="text-align: center; margin-top: var(--space-8)">
      <a href={pageHref(galleryHref)} class="btn btn--outline">{t.galleryCta}</a>
    </p>
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{reviews.eyebrow}</p>
      <h2 class="section__title">{reviews.title}</h2>
      <p class="section__lead">{reviews.lead}</p>
    </header>
    <GoogleRating
      rating={reviews.rating}
      count={reviews.count}
      countLabel={reviews.countLabel}
      starsLabel={reviews.starsLabel}
      cta={reviews.cta}
      url={reviews.url}
    />
    <GoogleReviewCards
      reviews={reviews.reviews}
      label={reviews.reviewsLabel}
      attribution={reviews.attribution}
      url={reviews.url}
      reviewCta={reviews.reviewCta}
      selectionNotice={reviews.selectionNotice}
    />
  </div>
</section>

<CTABanner
  title={t.ctaTitle}
  subtitle={t.ctaSubtitle}
  primaryCta={{ label: t.ctaPrimary, href: bookHref }}
  secondaryCta={{ label: t.ctaSecondary, href: contactHref }}
/>
