---
import { pageHref } from '../../utils/urls.js';
/**
 * HomeContent.astro - homepage body. Picks copy by `lang` prop.
 */
import Hero from '../sections/Hero.astro';
import FeatureCards from '../sections/FeatureCards.astro';
import Gallery from '../sections/Gallery.astro';
import GoogleRating from '../sections/GoogleRating.astro';
import GoogleReviewCards from '../sections/GoogleReviewCards.astro';
import CTABanner from '../sections/CTABanner.astro';

import { getGoogleReviews } from '../../data/googleReviews.js';

import heroImg from '../../assets/img/Hero-1.webp';
import tandemImg from '../../assets/img/website-selection/tandem/tandem-008.webp';
import affImg from '../../assets/img/website-selection/aff/aff-007.webp';
import funImg from '../../assets/img/Fun-1.webp';
import g1 from '../../assets/img/website-selection/action/action-026.webp';
import g2 from '../../assets/img/website-selection/tandem/tandem-009.webp';
import g3 from '../../assets/img/website-selection/action/action-008.webp';
import g4 from '../../assets/img/website-selection/dropzone/dropzone-016.webp';
import g5 from '../../assets/img/website-selection/aircraft/aircraft-004.webp';
import g6 from '../../assets/img/website-selection/action/action-027.webp';

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    newsCta: "Club news and events",
    heroEyebrow: 'Skydive Luxembourg a.s.b.l.',
    heroTitle: "Skydiving in Luxembourg.",
    heroSubtitle: "Tandem jumps, AFF training and sport skydiving at Noertrange airfield, near Wiltz. Sharing our sport since 1965.",
    heroPrimary: 'Book a tandem',
    heroSecondary: 'Learn to skydive',

    pickEyebrow: 'Three ways to jump',
    pickTitle: "From your first jump to sport skydiving.",
    pickLead: "Choose a first tandem skydive, explore AFF training, or plan a visit as an experienced jumper. Contact us at",

    cards: [
      { title: 'Tandem jumps', text: "Discover the tandem experience, from the briefing to the parachute flight. Read the requirements and booking options.", cta: 'Discover tandem', href: `/${''}en/tandem` },
      { title: 'AFF - learn to skydive', text: "Our Accelerated Freefall training introduces freefall and canopy skills. Find out how the course works and ask about the next dates.", cta: 'Discover AFF', href: `/${''}en/aff` },
      { title: 'Experienced jumpers', text: "Already licensed? Find jumping requirements, dropzone facilities and coaching contacts for your visit to Noertrange.", cta: 'Visit the DZ', href: `/${''}en/fun-jumpers` },
    ],

    galleryEyebrow: 'In the air',
    galleryTitle: 'A few moments from above.',
    galleryCta: 'See full gallery',

