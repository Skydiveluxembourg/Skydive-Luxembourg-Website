---
/**
 * NewsContent.astro - club news page. Picks copy by `lang` prop.
 *
 * To add refurbishment updates or other club news, edit src/data/clubNews.js.
 */
import { Image } from 'astro:assets';

import PageBanner from '../sections/PageBanner.astro';
import { posts } from '../../data/clubNews.js';

// Generic 'work in progress' backdrop for the page. Swap this file if a
// better shot of the works comes along - nothing else needs changing.
import bannerImg from '../../assets/img/news/news-hero-work-in-progress.webp';

const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    bannerEyebrow: 'Skydive Luxembourg',
    bannerTitle: 'Club news.',
    bannerSubtitle: 'Club life, events and the latest from the airfield.',
    bannerAlt: 'The fenced-off work area running alongside the runway at Noertrange airfield',
    lead: 'All the news from Skydive Luxembourg, newest first. Follow the runway refurbishment here, along with club updates, events and news from the dropzone.',
    statusEyebrow: 'Airfield refurbishment',
    statusTitle: 'Airfield closed for runway refurbishment.',
    statusBody: 'The airfield is closed while the runway is rebuilt, and we expect to reopen by June 2027. You can still buy a tandem jump: you will receive a reservation code, and as soon as reservations reopen you can use it to book the date you want.',
    empty: 'There are no updates yet. Please check back soon.',
    back: 'Back to home',
    contact: 'Questions? Contact us',
  },
  fr: {
    bannerEyebrow: 'Skydive Luxembourg',
    bannerTitle: 'Actualités du club.',
    bannerSubtitle: "La vie du club, les événements et les dernières nouvelles de l'aérodrome.",
    bannerAlt: "La zone de chantier clôturée le long de la piste de l'aérodrome de Noertrange",
    lead: "Toutes les actualités de Skydive Luxembourg, des plus récentes aux plus anciennes. Retrouvez ici le suivi de la réfection de la piste, ainsi que la vie du club, les événements et les nouvelles de la dropzone.",
    statusEyebrow: "Travaux à l'aérodrome",
    statusTitle: 'Aérodrome fermé pour réfection de la piste.',
    statusBody: "L'aérodrome est fermé pendant les travaux de réfection de la piste et nous prévoyons de rouvrir d'ici juin 2027. Vous pouvez toujours acheter un saut en tandem : vous recevrez un code de réservation qui vous permettra de choisir la date de votre choix dès la réouverture des réservations.",
    empty: "Il n'y a pas encore d'actualité. Revenez bientôt.",
    back: "Retour à l'accueil",
    contact: 'Une question ? Contactez-nous',
  },
  de: {
    bannerEyebrow: 'Skydive Luxembourg',
    bannerTitle: 'Neuigkeiten aus dem Verein.',
    bannerSubtitle: 'Vereinsleben, Veranstaltungen und Aktuelles vom Flugplatz.',
    bannerAlt: 'Die abgesperrte Baustelle entlang der Piste am Flugplatz Noertrange',
    lead: 'Alle Neuigkeiten von Skydive Luxembourg, die neuesten zuerst. Hier findest du Updates zur Pistensanierung, zum Vereinsleben, zu Veranstaltungen und zum Geschehen auf der Dropzone.',
    statusEyebrow: 'Arbeiten am Flugplatz',
    statusTitle: 'Flugplatz wegen Pistensanierung geschlossen.',
    statusBody: 'Der Flugplatz ist während der Sanierung der Piste geschlossen. Die Wiedereröffnung ist für Juni 2027 geplant. Du kannst weiterhin einen Tandemsprung kaufen und erhältst einen Reservierungscode. Sobald die Reservierungen wieder offen sind, kannst du damit deinen Wunschtermin buchen.',
    empty: 'Es gibt noch keine Neuigkeiten. Schau bald wieder vorbei.',
    back: 'Zur Startseite',
    contact: 'Fragen? Kontaktiere uns',
  },
  lu: {
    bannerEyebrow: 'Skydive Luxembourg',
    bannerTitle: 'Neiegkeeten aus dem Veräin.',
    bannerSubtitle: 'Veräinsliewen, Evenementer an Neiegkeete vun der Fluchplaz.',
    bannerAlt: "Déi ofgespaarte Baustell laanscht d'Piste op der Fluchplaz Noertrange",
    lead: "All d'Neiegkeete vu Skydive Luxembourg, déi neisten zeréischt. Hei fanns du Updates zu de Pistenaarbechten, zum Veräinsliewen, zu den Evenementer an zum Liewen op der Dropzone.",
    statusEyebrow: 'Aarbechten op der Fluchplaz',
    statusTitle: 'Fluchplaz wéinst Pistenerneierung zou.',
    statusBody: "D'Fluchplaz ass während den Erneierungsaarbechten un der Piste zou. Mir rechne domat, am Juni 2027 erëm opzemaachen. Du kanns weider en Tandemsprong kafen a kriss e Reservatiounscode. Soubal d'Reservatioune erëm op sinn, kanns du domat däin Wonschdatum buchen.",
    empty: 'Et gëtt nach keng Neiegkeeten. Kuck geschwë nees laanscht.',
    back: 'Zréck op d\'Startsäit',
    contact: 'Froen? Kontaktéier eis',
  },
};

const t = copy[lang] ?? copy.en;

// Date formatting follows the visitor's language.
const dateLocales = { en: 'en-GB', fr: 'fr-FR', de: 'de-DE', lu: 'lb-LU' };
const dateFormatter = new Intl.DateTimeFormat(dateLocales[lang] ?? 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// Midday UTC keeps the displayed day stable regardless of build timezone.
const formatDate = (iso) => dateFormatter.format(new Date(`${iso}T12:00:00Z`));

// Per-post fields are keyed by language, with English as the fallback so a
// missing translation degrades to readable copy instead of a blank block.
const pick = (field) => field?.[lang] ?? field?.en;
---

<PageBanner
  image={bannerImg}
  alt={t.bannerAlt}
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <p class="section__lead news__lead">{t.lead}</p>

    <section class="news__status" aria-labelledby="airfield-status">
      <p class="section__eyebrow">{t.statusEyebrow}</p>
      <h2 id="airfield-status" class="news__status-title">{t.statusTitle}</h2>
      <p>{t.statusBody}</p>
    </section>

    {posts.length === 0 ? (
      <p class="news__empty">{t.empty}</p>
    ) : (
      <div class="news__list">
        {posts.map((post) => {
          const photos = post.images ?? [];

          // Two photos to a row. Four in a single strip would be about 170px each,
          // too small to read; paired, they form a grid and stay legible. With an
          // odd count the first photo leads on its own at full width and the rest
          // follow in pairs, so no row is left with a lone photo at half width.
          // Put the photo that should lead first in the post's `images` list.
          const rows = [];
          let start = 0;
          if (photos.length % 2 === 1) {
            rows.push([photos[0]]);
            start = 1;
          }
          for (let i = start; i < photos.length; i += 2) rows.push(photos.slice(i, i + 2));

          return (
            <article class="news__item">
              <time class="news__date" datetime={post.date}>{formatDate(post.date)}</time>
              <h2 class="news__title">{pick(post.title)}</h2>

              {rows.map((row) => {
                // Photos in a row split the ~720px column by aspect ratio, so in a
                // portrait-and-landscape pair the landscape renders near 470px, not
                // 360px. Each photo asks for its real share; a flat 360px made the
                // browser fetch a variant too small and stretch it.
                const rowAr = row.reduce((sum, ph) => sum + ph.src.width / ph.src.height, 0);
                return (
                  <div class:list={['news__figures', { 'news__figures--single': row.length === 1 }]}>
                    {row.map((photo) => {
                      const ar = photo.src.width / photo.src.height;
                      const isPortrait = photo.src.height > photo.src.width;
                      // A lone portrait is capped at 460px by the CSS below.
                      const px = row.length === 1 && isPortrait ? 460 : Math.round((720 * ar) / rowAr);
                      return (
                        <Image
                          src={photo.src}
                          alt={pick(photo.alt) ?? ''}
                          class:list={['news__img', { 'news__img--portrait': isPortrait }]}
                          style={`--ar: ${ar.toFixed(4)}`}
                          widths={[400, 600, 900, 1200]}
                          sizes={`(max-width: 640px) 100vw, ${px}px`}
                          loading="lazy"
                        />
                      );
                    })}
                  </div>
                );
              })}

              <div class="news__body">
                {(pick(post.body) ?? []).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          );
        })}
      </div>
    )}

    <p class="news__actions">
      <a href={`/${lang}/`} class="btn btn--outline">{t.back}</a>
      <a href={`/${lang}/contact/`} class="btn btn--secondary">{t.contact}</a>
    </p>
  </div>
</section>

<style>
  .news__lead {
    /* .section__lead centres itself at 60ch, which leaves the intro visibly
       offset against the full-width posts below. Align it with them. */
    max-width: none;
    margin-inline: 0;
    margin-bottom: var(--space-12);
  }

  .news__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .news__status {
    margin-bottom: var(--space-12);
    padding: var(--space-6);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .news__status-title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-xl);
  }

  .news__item {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .news__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .news__date {
    display: block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .news__title {
    margin-top: var(--space-2);
    font-size: var(--fs-xl);
  }

  /* Photos share one row. Each grows in proportion to its aspect ratio, so a
     portrait and a landscape shot come out the same height without cropping
     either of them. --ar is set per image in the template. */
  .news__figures {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .news__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    flex-grow: var(--ar, 1);
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
  }

  /* Consecutive rows belong to one grid, so sit them closer than the gap that
     separates the photos from the heading above. */
  .news__figures + .news__figures {
    margin-top: var(--space-3);
  }

  /* A lone portrait shot at full column width runs about 975px tall and swamps
     the text. Cap it; in a row the proportional widths already handle this. */
  .news__figures--single .news__img--portrait {
    max-width: 460px;
    margin-inline: auto;
  }

  /* Too narrow for a row: stack, and rein the tall ones back in. */
  @media (max-width: 640px) {
    .news__figures {
      flex-direction: column;
    }
    .news__figures .news__img {
      flex-grow: 0;
      flex-basis: auto;
    }
    .news__figures .news__img--portrait {
      max-width: 460px;
      margin-inline: auto;
    }
  }

  .news__body {
    margin-top: var(--space-4);
  }
  .news__body p + p {
    margin-top: var(--space-4);
  }

  .news__empty {
    padding: var(--space-12) 0;
    color: var(--color-fg-muted);
    text-align: center;
  }

  .news__actions {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
