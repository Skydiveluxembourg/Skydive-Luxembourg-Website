---
import { Image } from 'astro:assets';
import { newsEntries } from '../../data/clubNews.js';
import { newsCopy, pickNews, newsLang, newsHref, formatNewsDate } from '../../utils/news.js';

const { lang = 'en' } = Astro.props;
const t = newsCopy(lang);
const pick = (field) => pickNews(field, lang);
---

<section class="section news">
  <div class="section__inner news__inner">
    <header class="news__header">
      <h1>{t.title}</h1>
      <p class="news__lead">{t.lead}</p>
    </header>

    <section aria-labelledby="latest-updates">
      <h2 class="news__list-heading" id="latest-updates">{t.updates}</h2>
      {newsEntries.length === 0 ? (
        <p class="news__empty">{t.empty}</p>
      ) : (
        <div class="news__list">
          {newsEntries.map((post, index) => {
            const photo = post.images?.[0];
            const containThumbnail = post.thumbnailFit === 'contain';
            const href = newsHref(lang, post);
            const summary = post.teaser ?? post.summary ?? post.body;
            return (
              <article class:list={['news-card', { 'news-card--no-image': !photo }]} id={post.id}>
                <div class="news-card__copy">
                  <p class="news-card__date">{post.updates && `${t.updated} `}<time datetime={post.date}>{formatNewsDate(post.date, lang)}</time></p>
                  <h3 class="news-card__title"><a href={href} lang={newsLang(post.title, lang)}>{pick(post.title)}</a></h3>
                  <p class="news-card__summary" lang={newsLang(summary, lang)}>{post.teaser || post.summary ? pick(summary) : pick(summary)?.[0]}</p>
                  <a class="news-card__read" href={href}>
                    {t.read}<span class="news-card__sr-only" lang={newsLang(post.title, lang)}>: {pick(post.title)}</span> <span aria-hidden="true">→</span>
                  </a>
                </div>
                {photo && (
                  <Image
                    src={photo.src}
                    alt={pick(photo.alt) ?? ''}
                    lang={newsLang(photo.alt, lang)}
                    class:list={['news-card__image', { 'news-card__image--contain': containThumbnail }]}
                    width={600}
                    height={containThumbnail ? Math.round(600 * photo.src.height / photo.src.width) : 450}
                    fit="cover"
                    quality={75}
                    widths={[320, 600, 900]}
                    sizes={containThumbnail ? '(max-width: 354px) calc(100vw - 74px), 280px' : '(max-width: 700px) calc(100vw - 74px), 280px'}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>

  </div>
</section>

<style>
  .news { padding-top: var(--space-10); }
  .news__inner { max-width: 1000px; }
  .news__header { margin-bottom: var(--space-6); }
  .news__header h1 { font-size: clamp(2rem, 4vw, 2.5rem); }
  .news__lead {
    max-width: 65ch;
    margin-top: var(--space-3);
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
  }
  .news__list-heading { margin-bottom: var(--space-5); font-size: var(--fs-xl); }
  .news__list { display: grid; gap: var(--space-6); }
  .news-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    scroll-margin-top: calc(var(--site-nav-height, 120px) + 24px);
  }
  .news-card--no-image { grid-template-columns: 1fr; }
  .news-card__date { display: block; color: var(--color-fg-muted); font-size: var(--fs-sm); }
  .news-card__title { margin-top: var(--space-2); font-size: var(--fs-xl); line-height: 1.25; }
  .news-card__title a { color: var(--color-fg); text-decoration: none; }
  .news-card__title a:hover { color: var(--color-link); text-decoration: underline; }
  .news-card__summary { margin-top: var(--space-3); }
  .news-card__sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .news-card__read {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-3);
    font-weight: var(--fw-medium);
  }
  .news-card__image { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-sm); }
  /* Keep group portraits complete so no one is cropped out of the preview. */
  .news-card__image--contain { aspect-ratio: auto; object-fit: contain; }
  .news__empty { padding-block: var(--space-8); color: var(--color-fg-muted); }
  .news :is(a, summary):focus-visible { outline: 3px solid var(--color-link); outline-offset: 4px; border-radius: 2px; }
  @media (max-width: 700px) {
    .news-card { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-5); }
    .news-card__title { font-size: 1.375rem; }
    .news-card__image { max-height: 240px; }
    .news-card__image--contain { max-width: 280px; max-height: none; margin-inline: auto; }
  }
</style>
