    emailLabel: 'E-Mail',
    addressLabel: 'Adresse',
    mailSubject: 'Partnerschaft 2027',
    brochureSubject: 'Partnerschaftsbroschüre 2027',
    mailCta: 'Schreiben Sie uns',
    brochureCta: 'Broschüre anfordern',

    ctaTitle: 'Unterschreiben, bevor das Band durchschnitten wird.',
    ctaSubtitle: 'Die Plätze auf dem Flugzeug sind begrenzt: Sagen Sie bis zum 31. Januar 2027 zu, damit Ihre Marke ab dem ersten Tag der Wiedereröffnung mitfliegt.',
    ctaPrimary: 'Kontakt aufnehmen',
    ctaSecondary: 'Den Verein kennenlernen',
  },
