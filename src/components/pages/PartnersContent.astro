// Luxembourgish is not published yet; fall back to English like the nav does.
const t = copy[lang] ?? copy.en;

const contact = {
  name: 'Fränz Hardt',
  email: 'mail@skydive.lu',
  addressLines: ['Aérodrome ELNT', '32, op der Louh', 'L-9676 Noertrange'],
};
const mailHref = (subject) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;

const partnerGroups = PARTNER_TIERS
  .map((tier) => ({ tier, label: t.tiers[tier], items: partners.filter((partner) => partner.tier === tier) }))
  .filter((group) => group.items.length > 0);
const placeholderSlots = Array.from({ length: LAUNCH_PARTNER_SLOTS });
const contactAnchor = '#partner-contact';
---

<PageBanner
  image={bannerImg}
  alt={t.bannerAlt}
  imagePosition="center 45%"
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<!-- Our partners ---------------------------------------------------------->
<section class="section">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.partnersEyebrow}</p>
      <h2 class="section__title">{t.partnersTitle}</h2>
      <p class="section__lead">{t.partnersLead}</p>
    </header>

    <div class="partners-launch">
      <h3 class="partners-launch__title">{t.launchTitle}</h3>
      <p class="partners-launch__text">{t.launchText}</p>

      {partnerGroups.length === 0 ? (
        <ul class="partners-logos" role="list">
          {placeholderSlots.map(() => (
            <li>
              <a href={contactAnchor} class="partners-logo partners-logo--placeholder">
                <span class="partners-logo__placeholder-label">{t.placeholder}</span>
                <span class="partners-logo__placeholder-cta">{t.placeholderCta} →</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <>
          {partnerGroups.map((group) => (
            <div class="partners-group">
              <h4 class="partners-group__title">{group.label}</h4>
              <ul class="partners-logos" role="list">
                {group.items.map((partner) => (
                  <li>
                    {partner.url ? (
                      <a href={partner.url} class="partners-logo" target="_blank" rel="sponsored noopener noreferrer">
                        <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
                      </a>
                    ) : (
                      <div class="partners-logo">
                        <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <ul class="partners-logos partners-logos--invite" role="list">
            <li>
              <a href={contactAnchor} class="partners-logo partners-logo--placeholder">
                <span class="partners-logo__placeholder-label">{t.placeholder}</span>
                <span class="partners-logo__placeholder-cta">{t.placeholderCta} →</span>
              </a>
            </li>
          </ul>
        </>
      )}
    </div>

    <ul class="grid grid--3 partners-institutions" role="list">
      {t.institutions.map((item) => (
        <li class="partners-institution">
          <p class="partners-institution__label">{item.label}</p>
          <p class="partners-institution__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Five reasons ---------------------------------------------------------->
<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.reasonsEyebrow}</p>
      <h2 class="section__title">{t.reasonsTitle}</h2>
      <p class="section__lead">{t.reasonsLead}</p>
    </header>
    <ol class="partners-reasons" role="list">
      {t.reasons.map((reason, index) => (
        <li class="partners-reason">
          <span class="partners-reason__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="partners-reason__title">{reason.title}</h3>
          <p class="partners-reason__text">{reason.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Key figures ----------------------------------------------------------->
<section class="section section--dark section--tight">
  <div class="section__inner">
    <header class="section__header partners-stats__header">
      <p class="section__eyebrow">{t.statsEyebrow}</p>
      <h2 class="section__title">{t.statsTitle}</h2>
    </header>
    <dl class="partners-stats">
      {t.stats.map((stat) => (
        <div class="partners-stat">
          <dt class="partners-stat__label">{stat.label}</dt>
          <dd class="partners-stat__value">{stat.value}</dd>
        </div>
      ))}
    </dl>
    <p class="partners-stats__note">{t.statsNote}</p>
  </div>
</section>

<!-- Where your brand flies ------------------------------------------------>
<section class="section">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.placementEyebrow}</p>
      <h2 class="section__title">{t.placementTitle}</h2>
      <p class="section__lead">{t.placementLead}</p>
    </header>

    <div class="grid grid--2 partners-aircraft">
      <div class="partners-aircraft__media">
        <Image
          src={aircraftImg}
          alt={t.aircraftAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 600px) 100vw, 50vw"
          quality={78}
        />
      </div>
      <div>
        <h3 class="partners-subtitle">{t.aircraftTitle}</h3>
        <ul class="partners-zones" role="list">
          {t.zones.map((zone) => (
            <li class:list={['partners-zone', `partners-zone--${zone.tier}`]}>
              <p class="partners-zone__label">{zone.label}</p>
              <ul class="partners-zone__items">
                {zone.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))}
        </ul>
        <p class="partners-note">{t.zonesNote}</p>
      </div>
    </div>

    <h3 class="partners-subtitle partners-subtitle--center">{t.groundTitle}</h3>
    <ul class="grid grid--4 partners-ground" role="list">
      {t.ground.map((item, index) => (
        <li class="partners-ground__item">
          <span class="partners-ground__number" aria-hidden="true">{String(index + 7).padStart(2, '0')}</span>
          <h4 class="partners-ground__title">{item.title}</h4>
          <p class="partners-ground__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Ways to partner ------------------------------------------------------->
<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.formatsEyebrow}</p>
      <h2 class="section__title">{t.formatsTitle}</h2>
      <p class="section__lead">{t.formatsLead}</p>
    </header>

    <ul class="partners-levels" role="list">
      {t.levels.map((level) => (
        <li class:list={['partners-level', `partners-level--${level.tier}`]}>
          <h3 class="partners-level__name">{level.name}</h3>
          <p class="partners-level__tag">{level.tag}</p>
          <p class="partners-level__text">{level.text}</p>
        </li>
      ))}
    </ul>
    <p class="partners-all-levels">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span>{t.allLevels}</span>
    </p>

    <h3 class="partners-subtitle partners-subtitle--center">{t.othersTitle}</h3>
    <ul class="grid grid--3 partners-others" role="list">
      {t.others.map((item) => (
        <li class="partners-card">
          <h4 class="partners-card__title">{item.title}</h4>
          <p class="partners-card__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 2027 timeline --------------------------------------------------------->
<section class="section">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.timelineEyebrow}</p>
      <h2 class="section__title">{t.timelineTitle}</h2>
      <p class="section__lead">{t.timelineLead}</p>
    </header>
    <ol class="partners-timeline" role="list">
      {t.timeline.map((item) => (
        <li class:list={['partners-timeline__item', { 'is-highlight': item.highlight }]}>
          <p class="partners-timeline__date">{item.date}</p>
          <p class="partners-timeline__text">{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Next steps and contact ------------------------------------------------>
<section class="section section--alt" id="partner-contact">
  <div class="section__inner">
    <div class="grid grid--2 partners-next">
      <div>
        <p class="section__eyebrow">{t.stepsEyebrow}</p>
        <h2 class="section__title">{t.stepsTitle}</h2>
        <ol class="partners-steps" role="list">
          {t.steps.map((step, index) => (
            <li class="partners-step">
              <span class="partners-step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="partners-step__title">{step.title}</h3>
                <p class="partners-step__text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="partners-contact">
        <p class="partners-contact__eyebrow">{t.contactTitle}</p>
        <p class="partners-contact__name">{contact.name}</p>
        <p class="partners-contact__role">{t.contactRole}</p>
        <dl class="partners-contact__list">
          <dt>{t.phoneLabel}</dt>
          <dd>{t.phoneText}</dd>
          <dt>{t.emailLabel}</dt>
          <dd><a href={mailHref(t.mailSubject)}>{contact.email}</a></dd>
          <dt>{t.addressLabel}</dt>
          <dd>
            {contact.addressLines.map((line, i) => (
              <>{line}{i < contact.addressLines.length - 1 && <br />}</>
            ))}
          </dd>
        </dl>
        <div class="partners-contact__actions">
          <a class="btn btn--primary" href={mailHref(t.mailSubject)}>{t.mailCta}</a>
          <a class="btn btn--outline" href={mailHref(t.brochureSubject)}>{t.brochureCta}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<CTABanner
  title={t.ctaTitle}
  subtitle={t.ctaSubtitle}
  primaryCta={{ label: t.ctaPrimary, href: mailHref(t.mailSubject) }}
  secondaryCta={{ label: t.ctaSecondary, href: pageHref(`/${lang}/about`) }}
/>

<style>
  /* Tier accents, shared by the aircraft zones and the partnership levels. */
  .partners-zone--title, .partners-level--title         { --tier-color: var(--color-red); }
  .partners-zone--gold, .partners-level--gold           { --tier-color: #C9971C; }
  .partners-zone--silver, .partners-level--silver       { --tier-color: #8F9AA5; }
  .partners-level--bronze                               { --tier-color: #A8693D; }
  .partners-level--supporter                            { --tier-color: var(--color-blue); }

  /* :where() keeps this reset at zero specificity, so the margins set on the
     lists' own classes (e.g. the space above the institution boxes) apply. */
  :where(ul[role="list"], ol[role="list"]) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partners-subtitle {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-4);
  }
  .partners-subtitle--center {
    text-align: center;
    margin-top: var(--space-16);
    margin-bottom: var(--space-8);
  }

  .partners-note {
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }

  /* ---------- Partner logos ------------------------------------------- */

  .partners-launch {
    text-align: center;
    max-width: 960px;
    margin: 0 auto;
  }
  .partners-launch__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-2);
  }
  .partners-launch__text {
    color: var(--color-fg-muted);
    max-width: 60ch;
    margin: 0 auto var(--space-8);
  }

  .partners-group + .partners-group { margin-top: var(--space-8); }
  .partners-group__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-4);
  }

  .partners-logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }
  .partners-logos--invite {
    margin-top: var(--space-8);
    grid-template-columns: minmax(160px, 220px);
    justify-content: center;
  }

  .partners-logo {
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    /* Logos are designed for light backgrounds, so the tile stays white in both themes. */
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }
  a.partners-logo:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .partners-logo img {
    max-width: 100%;
    max-height: 72px;
    object-fit: contain;
  }

  .partners-logo--placeholder {
    flex-direction: column;
    gap: var(--space-2);
    background: transparent;
    border: 2px dashed var(--color-border);
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .partners-logo--placeholder:hover,
  .partners-logo--placeholder:focus-visible {
    border-color: var(--color-link);
    color: var(--color-link);
  }
  .partners-logo__placeholder-label {
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .partners-logo__placeholder-cta {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-link-accent);
  }

