---
import { pageHref } from '../../utils/urls.js';
/**
 * AboutContent.astro - about page body. Picks copy by `lang` prop.
 */
import PageBanner from '../sections/PageBanner.astro';
import FeatureCards from '../sections/FeatureCards.astro';
import CTABanner from '../sections/CTABanner.astro';

import bannerImg from '../../assets/img/Fun-1.webp';
import tandemImg from '../../assets/img/website-selection/tandem/tandem-008.webp';
import affImg from '../../assets/img/website-selection/aff/aff-007.webp';
import funImg from '../../assets/img/website-selection/action/action-026.webp';

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    newsCta: "Follow our club news and events",
    activityLinks: ["Explore tandem skydives", "Learn about AFF training", "Information for experienced jumpers"],
    bannerEyebrow: 'About us',
    bannerTitle: "Our skydiving club in Luxembourg.",
    bannerSubtitle: "A non-profit club run by jumpers, for jumpers, at Noertrange airfield near Wiltz.",

    introEyebrow: 'Who we are',
    introTitle: 'More than 60 years of skydiving in Luxembourg.',
    introText: 'The Cercle Parachutiste Luxembourgeois a.s.b.l., now Skydive Luxembourg a.s.b.l., was founded in 1965 and has carried out its skydiving activities in Luxembourg ever since. It is the only skydiving club in Luxembourg.',

    whatEyebrow: 'What we do',
    whatTitle: 'Three activities, one community.',
    whatLead: "From a first tandem jump to AFF training and sport skydiving, find the activity that fits your experience.",

    cards: [
      { title: 'Tandem skydives', text: "Discover skydiving with a tandem master. Read about the experience, participation requirements and booking options.", image: tandemImg, alt: 'Tandem skydive in freefall' },
      { title: 'AFF student training', text: "Explore ground school and the seven AFF levels before continuing towards independent skydiving.", image: affImg, alt: 'AFF student in freefall with instructors' },
      { title: 'Sport jumpers', text: "Practical information for licensed skydivers visiting Noertrange: requirements, dropzone facilities and coaching contacts.", image: funImg, alt: 'Sport jumpers exiting the aircraft' },
    ],

    historyEyebrow: 'Our history',
    historyTitle: 'From Cercle Para to Skydive Luxembourg.',
    historyText: 'The club celebrated its 60th anniversary in 2025 with the Sexy Sixty Boogie during jump week, including several jump aircraft, evening animation, load organising and activities. The name has moved forward to Skydive Luxembourg, but the club history remains part of the story.',

    ethosEyebrow: 'Our ethos',
    ethosTitle: 'Safety first. Fun a very close second.',
    ethosText: "Skydiving is a club sport as well as an individual challenge. We value preparation, clear briefings, learning from one another and a welcoming atmosphere for newcomers and experienced jumpers.",

    ctaTitle: 'Come and meet us.',
    ctaSubtitle: "Interested in tandem skydiving, AFF training or club life? Contact us to plan your visit to Noertrange.",
    ctaPrimary: 'Book a tandem',
    ctaSecondary: 'Contact us',
  },

  fr: {
    newsCta: "Suivre les actualités et la vie du club",
    activityLinks: ["Découvrir le saut en tandem", "Découvrir la formation AFF", "Informations pour parachutistes confirmés"],
    bannerEyebrow: 'À propos',
    bannerTitle: "Notre club de parachutisme au Luxembourg.",
    bannerSubtitle: "Un club sans but lucratif, géré par et pour les parachutistes, à l’aérodrome de Noertrange près de Wiltz.",

    introEyebrow: 'Qui sommes-nous',
    introTitle: 'Plus de 60 ans de parachutisme au Luxembourg.',
    introText: 'Le Cercle Parachutiste Luxembourgeois a.s.b.l., aujourd’hui Skydive Luxembourg a.s.b.l., a été créé en 1965 et exerce depuis ses activités de parachutisme au Luxembourg. C’est le seul club de parachutisme au Luxembourg.',

    whatEyebrow: 'Nos activités',
    whatTitle: 'Trois activités, une seule communauté.',
    whatLead: "Du premier saut en tandem à la formation AFF et au parachutisme sportif, découvrez l’activité adaptée à votre expérience.",

    cards: [
      { title: 'Sauts en tandem', text: "Découvrez le parachutisme avec un moniteur tandem. Consultez le déroulement du saut, les conditions de participation et les options de réservation.", image: tandemImg, alt: 'Saut en tandem en chute libre' },
      { title: 'Formation AFF', text: "Découvrez la formation au sol et les sept niveaux AFF avant de poursuivre votre progression vers le parachutisme autonome.", image: affImg, alt: 'Élève AFF en chute libre avec moniteurs' },
      { title: 'Parachutistes brevetés', text: "Informations pratiques pour les parachutistes brevetés à Noertrange : conditions, infrastructures et contacts pour le coaching.", image: funImg, alt: 'Parachutistes confirmés à la sortie de l\'avion' },
    ],

    historyEyebrow: 'Notre histoire',
    historyTitle: 'Du Cercle Para à Skydive Luxembourg.',
    historyText: 'Le club a fêté ses 60 ans en 2025 avec le Sexy Sixty Boogie pendant la semaine de sauts, avec plusieurs avions largueurs, animations en soirée, load organising et activités. Le nom a évolué vers Skydive Luxembourg, mais l’histoire du club reste une partie de notre histoire.',

    ethosEyebrow: 'Notre philosophie',
    ethosTitle: 'La sécurité d\'abord. Le plaisir juste après.',
    ethosText: "Le parachutisme est un sport de club autant qu’un défi personnel. Nous tenons à la préparation, à des briefings clairs, à l’apprentissage entre parachutistes et à un accueil chaleureux pour les débutants comme pour les plus expérimentés.",

    ctaTitle: 'Venez nous rencontrer.',
    ctaSubtitle: "Un saut en tandem, une formation AFF ou la vie du club vous intéresse ? Contactez-nous pour préparer votre visite à Noertrange.",
    ctaPrimary: 'Réserver un tandem',
    ctaSecondary: 'Nous contacter',
  },

  de: {
    newsCta: "Neuigkeiten und Vereinsleben verfolgen",
    activityLinks: ["Tandemsprünge entdecken", "Zur AFF-Ausbildung", "Informationen für erfahrene Springer"],
    bannerEyebrow: 'Über uns',
    bannerTitle: "Unser Fallschirmsportverein in Luxemburg.",
    bannerSubtitle: "Ein gemeinnütziger Verein von Springern für Springer am Flugplatz Noertrange bei Wiltz.",

    introEyebrow: 'Wer wir sind',
    introTitle: 'Mehr als 60 Jahre Fallschirmsport in Luxemburg.',
    introText: 'Der Cercle Parachutiste Luxembourgeois a.s.b.l., heute Skydive Luxembourg a.s.b.l., wurde 1965 gegründet und betreibt seither Fallschirmsport in Luxemburg. Er ist der einzige Fallschirmverein in Luxemburg.',

    whatEyebrow: 'Was wir tun',
    whatTitle: 'Drei Aktivitäten, eine Gemeinschaft.',
    whatLead: "Vom ersten Tandemsprung über die AFF-Ausbildung bis zum Fallschirmsport: Finde das passende Angebot für deine Erfahrung.",

    cards: [
      { title: 'Tandemsprünge', text: "Entdecke das Fallschirmspringen mit einem Tandemmaster. Informiere dich über den Ablauf, die Teilnahmevoraussetzungen und Buchungsoptionen.", image: tandemImg, alt: 'Tandemsprung im freien Fall' },
      { title: 'AFF-Ausbildung', text: "Lerne die Bodenausbildung und die sieben AFF-Stufen kennen, bevor du deinen Weg zum selbstständigen Fallschirmspringen fortsetzt.", image: affImg, alt: 'AFF-Schüler im freien Fall mit Lehrern' },
      { title: 'Sportspringer', text: "Praktische Informationen für lizenzierte Springer in Noertrange: Voraussetzungen, Einrichtungen und Coaching-Kontakte.", image: funImg, alt: 'Sportspringer beim Ausstieg' },
    ],

    historyEyebrow: 'Unsere Geschichte',
    historyTitle: 'Vom Cercle Para zu Skydive Luxembourg.',
    historyText: 'Der Club feierte 2025 sein 60-jähriges Bestehen mit dem Sexy Sixty Boogie während der Sprungwoche, mit mehreren Absetzflugzeugen, Abendanimation, Load Organising und Aktivitäten. Der Name hat sich zu Skydive Luxembourg weiterentwickelt, aber die Vereinsgeschichte bleibt Teil unserer Geschichte.',

    ethosEyebrow: 'Unsere Philosophie',
    ethosTitle: 'Sicherheit zuerst. Spaß ganz knapp dahinter.',
    ethosText: "Fallschirmspringen ist Vereinssport und persönliche Herausforderung zugleich. Vorbereitung, klare Briefings, gemeinsames Lernen und eine offene Atmosphäre für Anfänger und erfahrene Springer sind uns wichtig.",

    ctaTitle: 'Komm vorbei.',
    ctaSubtitle: "Du interessierst dich für Tandemsprünge, AFF-Ausbildung oder das Vereinsleben? Kontaktiere uns, um deinen Besuch in Noertrange zu planen.",
    ctaPrimary: 'Tandem buchen',
    ctaSecondary: 'Kontakt',
  },

  lu: {
    newsCta: "Neiegkeeten a Veräinsliewen nokucken",
    activityLinks: ["Tandemspréng entdecken", "Iwwer d’AFF-Ausbildung", "Informatioune fir erfuerene Sprénger"],
    bannerEyebrow: 'Iwwer eis',
    bannerTitle: "Eise Fallschiermsveräin zu Lëtzebuerg.",
    bannerSubtitle: "E Veräin ouni Gewënnzweck, vu Sprénger fir Sprénger, op der Fluchplaz Noertrange bei Wolz.",

    introEyebrow: 'Wer mir sind',
    introTitle: 'Méi wéi 60 Joer Fallschiermsport in Lëtzebuerg.',
    introText: 'Der Cercle Parachutiste Luxembourgeois a.s.b.l., haut Skydive Luxembourg a.s.b.l., wurde 1965 gegründet an betreibt säither Fallschiermsport in Lëtzebuerg. Er ist der einzige Fallschiermveräin in Lëtzebuerg.',

    whatEyebrow: 'Was mir tun',
    whatTitle: 'Drei Aktivitäten, eine Communauté.',
    whatLead: "Vum éischten Tandemsprong iwwer d’AFF-Ausbildung bis bei de Fallschiermsport: Entdeck dat, wat zu denger Erfarung passt.",

    cards: [
      { title: 'Tandemspréng', text: "Entdeck d’Fallschiermsprange mat engem Tandemmaster. Informéier dech iwwer den Oflaf, d’Viraussetzungen an d’Reservatiounsméiglechkeeten.", image: tandemImg, alt: 'Tandemsprong im fräie Fall' },
      { title: 'AFF-Ausbildung', text: "Léier d’Buedemausbildung an déi siwen AFF-Niveaue kennen, ier s du däi Wee beim selbststännege Fallschiermsprange weidergees.", image: affImg, alt: 'AFF-Schüler im fräie Fall mat Instrukterenn' },
      { title: 'Sportsprénger', text: "Praktesch Informatioune fir lizenzéiert Sprénger zu Noertrange: Viraussetzungen, Ariichtungen a Coaching-Kontakter.", image: funImg, alt: 'Sportsprénger beim Ausstieg' },
    ],

    historyEyebrow: 'Eis Geschicht',
    historyTitle: 'Vom Cercle Para zu Skydive Luxembourg.',
    historyText: 'Der Club feierte 2025 sein 60-jähriges Bestehen mat dem Sexy Sixty Boogie während der Sprongwoche, mat mehreren Absetzflugzeugen, Abendanimation, Load Organising an Aktivitäten. Der Numm hat sich zu Skydive Luxembourg weiterentwickelt, aber die Veräinsgeschichte bleibt Teil eisr Geschicht.',

    ethosEyebrow: 'Eis Philosophie',
    ethosTitle: 'Sécherheet zuerst. Spaass ganz knapp dahinter.',
    ethosText: "Fallschiermsprangen ass e Veräinssport an eng perséinlech Erausfuerderung. Virbereedung, kloer Briefingen, zesumme léieren an e frëndlechen Empfang fir Ufänger an erfuerene Sprénger si fir eis wichteg.",

    ctaTitle: 'Komm vorbei.',
    ctaSubtitle: "Du interesséiers dech fir Tandemspréng, AFF-Ausbildung oder d’Veräinsliewen? Kontaktéier eis, fir däi Besuch zu Noertrange ze plangen.",
    ctaPrimary: 'Tandem buchen',
    ctaSecondary: 'Kontakt',
  },
}[lang];

const activities = ['tandem', 'aff', 'fun-jumpers'];
const cards = t.cards.map((card, index) => ({
  ...card,
  href: pageHref(`/${lang}/${activities[index]}`),
  cta: t.activityLinks[index],
}));

const bookHref = `/${lang}/tandem#book`;
const contactHref = `/${lang}/contact`;
const newsHref = `/${lang}/news`;
---

<PageBanner
  image={bannerImg}
  alt="Solo skydiver exiting the aircraft above Luxembourg"
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.introEyebrow}</p>
      <h2 class="section__title">{t.introTitle}</h2>
      <p class="section__lead">{t.introText}</p>
    </header>
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.whatEyebrow}</p>
      <h2 class="section__title">{t.whatTitle}</h2>
      <p class="section__lead">{t.whatLead}</p>
    </header>
    <FeatureCards items={cards} />
  </div>
</section>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.historyEyebrow}</p>
      <h2 class="section__title">{t.historyTitle}</h2>
      <p class="section__lead">{t.historyText}</p>
      <p style="margin-top: var(--space-4)"><a href={pageHref(newsHref)}>{t.newsCta}</a></p>
    </header>
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.ethosEyebrow}</p>
      <h2 class="section__title">{t.ethosTitle}</h2>
      <p class="section__lead">{t.ethosText}</p>
    </header>
  </div>
</section>

<CTABanner
  title={t.ctaTitle}
  subtitle={t.ctaSubtitle}
  primaryCta={{ label: t.ctaPrimary, href: bookHref }}
  secondaryCta={{ label: t.ctaSecondary, href: contactHref }}
/>
