---
import { pageHref } from '../../utils/urls.js';
/**
 * FunJumpersContent.astro - sport jumpers page body. Picks copy by `lang` prop.
 */
import PageBanner from '../sections/PageBanner.astro';
import FeatureCards from '../sections/FeatureCards.astro';
import CTABanner from '../sections/CTABanner.astro';
import FunJumperForm from '../FunJumperForm.astro';

import bannerImg from '../../assets/img/website-selection/dropzone/dropzone-016.webp';
import planeImg from '../../assets/img/website-selection/aircraft/aircraft-004.webp';
import packingImg from '../../assets/img/website-selection/dropzone/dropzone-021.webp';
import briefingImg from '../../assets/img/website-selection/dropzone/dropzone-012.webp';
import hangarImg from '../../assets/img/website-selection/dropzone/dropzone-003.webp';

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    relatedNews: "Club news and events",
    bannerEyebrow: 'Sport jumpers',
    bannerTitle: "Sport skydiving in Luxembourg.",
    bannerSubtitle: "Dropzone information, jumping requirements and coaching contacts for licensed skydivers visiting Noertrange, near Wiltz.",

    introEyebrow: 'About the DZ',
    introTitle: 'Small dropzone. Big sky.',
    introText: "Noertrange airfield, near Wiltz in northern Luxembourg, is home to our skydiving club. Alongside visiting licensed jumpers, club members share training jumps, coaching and activities on the dropzone. Check club news and contact us about jump days and coaching before planning your visit.",

    facEyebrow: 'Facilities',
    facTitle: 'Everything you need on site.',
    facLead: 'Clean, well-equipped infrastructure so you can focus on jumping.',

    cards: [
      { title: 'GA8 Airvan', text: '4 000 m in about 20 minutes, with 7 places for parachutists.', image: planeImg, alt: 'GA8 Airvan jump aircraft' },
      { title: 'Gear', text: 'Club equipment includes Next, Firebird, Vector 3 and Omega systems, with canopies from 150 to 260 and accessories.', image: packingImg, alt: 'Parachute equipment at the dropzone' },
      { title: 'Coaching', text: 'Instructors are available if you want to develop your skills in the different skydiving disciplines. Please contact us before coming to the DZ.', image: briefingImg, alt: 'Briefing room' },
      { title: 'Infrastructure', text: 'Covered packing area, video briefing and debriefing, bar and showers on site.', image: hangarImg, alt: 'Hangar and clubhouse' },
    ],

    opsEyebrow: 'Operations',
    opsTitle: 'How we run the day.',
    opsLead: 'Please make sure your licence, insurance and documents match the accepted requirements before coming to jump.',
    opsItems: [
      'We usually jump from 4 000 m; the GA8 Airvan reaches altitude in about 20 minutes.',
      'Check planned jump days and club activities with us before travelling.',
      "Contact the club to confirm a jump day and visitor check-in. Club membership is not required; guest jump rates apply.",
      'Coaching is available in different skydiving disciplines, but please contact us before coming to the DZ.',
      'In general, you must have completed basic training (AFF or Static Line).',
      'Accepted licences: Luxembourgish Parachutist Licence; USPA minimum A Licence; DFV (Germany) AFF Ausbildung and minimum 23 jumps; FWCP (Belgium) minimum Brevet A; FFP (France) minimum Brevet B.',
      'Bring your licence, logbook, valid insurance and equipment documents for check-in.',
    ],

    formEyebrow: 'Plan your visit',
    formTitle: 'Plan your visit.',
    formText: "Use the form below to tell us about your experience and plans as a visiting jumper. We will discuss jump dates, documents and any coaching requests with you.",

    ctaTitle: 'Blue skies and big smiles.',
    ctaSubtitle: 'See you in the manifest queue.',
    ctaPrimary: "Plan your visit",
    ctaSecondary: 'Contact the DZ',
    relatedPricing: 'See member, guest and rental prices',
  },

  fr: {
    relatedNews: "Actualités et vie du club",
    bannerEyebrow: 'Parachutistes confirmés',
    bannerTitle: "Parachutisme sportif au Luxembourg.",
    bannerSubtitle: "Informations sur la dropzone, conditions de saut et contacts pour le coaching des parachutistes brevetés à Noertrange, près de Wiltz.",

    introEyebrow: 'À propos de la DZ',
    introTitle: 'Petite DZ. Grand ciel.',
    introText: "L’aérodrome de Noertrange, près de Wiltz dans le nord du Luxembourg, accueille notre club de parachutisme. Membres et parachutistes brevetés de passage partagent sauts d’entraînement, coaching et vie de la dropzone. Consultez les actualités du club et contactez-nous au sujet des journées de saut et du coaching avant de préparer votre venue.",

    facEyebrow: 'Infrastructures',
    facTitle: 'Tout ce qu\'il vous faut sur place.',
    facLead: 'Une infrastructure propre et bien équipée pour vous concentrer sur le saut.',

    cards: [
      { title: 'GA8 Airvan', text: '4 000 m en environ 20 minutes, avec 7 places parachutistes.', image: planeImg, alt: 'Avion GA8 Airvan' },
      { title: 'Matériel', text: 'Le matériel club comprend des systèmes Next, Firebird, Vector 3 et Omega, avec voiles de 150 à 260 et accessoires.', image: packingImg, alt: 'Matériel parachute de la DZ' },
      { title: 'Coaching', text: 'Des instructeurs sont à votre disposition si vous désirez développer vos compétences dans les différentes disciplines du parachutisme. Contactez-nous avant de passer à la DZ.', image: briefingImg, alt: 'Salle de briefing' },
      { title: 'Infrastructure', text: 'Salle de pliage couverte, brief et débrief vidéo, bar et douches sur place.', image: hangarImg, alt: 'Hangar et club-house' },
    ],

    opsEyebrow: 'Opérations',
    opsTitle: 'Comment se déroule la journée.',
    opsLead: 'Vérifiez que votre licence, assurance et documents correspondent aux exigences acceptées avant de venir sauter.',
    opsItems: [
      'Nous sautons généralement de 4 000 m; le GA8 Airvan atteint l’altitude en environ 20 minutes.',
      'Renseignez-vous sur les journées de saut et les activités du club avant de vous déplacer.',
      "Contactez le club pour confirmer une journée de saut et les modalités d’accueil. Aucune adhésion au club n’est requise ; les tarifs visiteurs s’appliquent.",
      'Du coaching est disponible dans différentes disciplines du parachutisme; contactez-nous avant de passer à la DZ.',
      'En général, vous devez avoir terminé une formation de base (AFF ou Static Line).',
      'Licences acceptées : Licence de parachutiste luxembourgeoise; USPA minimum A Licence; DFV (Allemagne) AFF Ausbildung et minimum 23 sauts; FWCP (Belgique) minimum Brevet A; FFP (France) minimum Brevet B.',
      'Présentez votre licence, carnet de sauts, assurance valide et documents matériel lors du check-in.',
    ],

    formEyebrow: 'Préparez votre venue',
    formTitle: 'Manifestez à l\'avance.',
    formText: "Utilisez le formulaire ci-dessous pour nous présenter votre expérience et votre projet de visite. Nous échangerons avec vous sur les dates de saut, les documents et vos éventuelles demandes de coaching.",

    ctaTitle: 'Ciels bleus et grands sourires.',
    ctaSubtitle: 'À tout à l\'heure dans la file du manifest.',
    ctaPrimary: "Préparer votre venue",
    ctaSecondary: 'Contacter la DZ',
    relatedPricing: 'Voir les prix membres, visiteurs et location',
  },

  de: {
    relatedNews: "Neuigkeiten und Vereinsleben",
    bannerEyebrow: 'Sportspringer',
    bannerTitle: "Fallschirmsport in Luxemburg.",
    bannerSubtitle: "Informationen zur Dropzone, Sprungvoraussetzungen und Coaching-Kontakte für lizenzierte Springer in Noertrange bei Wiltz.",

    introEyebrow: 'Über die DZ',
    introTitle: 'Kleine DZ. Großer Himmel.',
    introText: "Der Flugplatz Noertrange bei Wiltz im Norden Luxemburgs ist die Heimat unseres Fallschirmsportvereins. Vereinsmitglieder und lizenzierte Gastspringer teilen Trainingssprünge, Coaching und das Leben auf der Dropzone. Lies die Vereinsneuigkeiten und frage uns vor deinem Besuch nach Sprungtagen und Coaching.",

    facEyebrow: 'Einrichtungen',
    facTitle: 'Alles, was du brauchst, vor Ort.',
    facLead: 'Saubere, gut ausgestattete Infrastruktur, damit du dich aufs Springen konzentrieren kannst.',

    cards: [
      { title: 'GA8 Airvan', text: '4 000 m in etwa 20 Minuten, mit 7 Plätzen für Fallschirmspringer.', image: planeImg, alt: 'GA8 Airvan' },
      { title: 'Material', text: 'Clubmaterial: Next, Firebird, Vector 3 und Omega Systeme, Schirme von 150 bis 260 sowie Zubehör.', image: packingImg, alt: 'Fallschirmausrüstung der DZ' },
      { title: 'Coaching', text: 'Lehrer stehen zur Verfügung, wenn du deine Fähigkeiten in verschiedenen Fallschirmsport-Disziplinen weiterentwickeln möchtest. Bitte kontaktiere uns vor deinem Besuch.', image: briefingImg, alt: 'Briefing-Raum' },
      { title: 'Infrastruktur', text: 'Überdachter Packbereich, Video-Briefing und -Debriefing, Bar und Duschen vor Ort.', image: hangarImg, alt: 'Hangar und Vereinsheim' },
    ],

    opsEyebrow: 'Betrieb',
    opsTitle: 'So läuft der Sprungtag ab.',
    opsLead: 'Bitte stelle sicher, dass Lizenz, Versicherung und Dokumente den akzeptierten Anforderungen entsprechen, bevor du zum Springen kommst.',
    opsItems: [
      'Wir springen normalerweise aus 4 000 m; die GA8 Airvan erreicht die Höhe in etwa 20 Minuten.',
      'Erkundige dich vor deiner Anreise nach geplanten Sprungtagen und Vereinsaktivitäten.',
      "Kontaktiere den Verein, um einen Sprungtag und die Anmeldung vor Ort abzustimmen. Eine Club-Mitgliedschaft ist nicht erforderlich; es gelten die Gastsprung-Preise.",
      'Coaching ist in verschiedenen Fallschirmsport-Disziplinen möglich; bitte vorher Kontakt aufnehmen.',
      'Grundsätzlich musst du eine Grundausbildung (AFF oder Static Line) abgeschlossen haben.',
      'Akzeptierte Lizenzen: Luxemburgische Fallschirmspringerlizenz; USPA mindestens A Licence; DFV (Deutschland) AFF Ausbildung und mindestens 23 Sprünge; FWCP (Belgien) mindestens Brevet A; FFP (Frankreich) mindestens Brevet B.',
      'Bring Lizenz, Sprungbuch, gültige Versicherung und Materialdokumente zum Check-in mit.',
    ],

    formEyebrow: 'Plane deinen Besuch',
    formTitle: 'Vorab anmelden.',
    formText: "Erzähle uns im Formular von deiner Erfahrung und deinem geplanten Besuch als Gastspringer. Wir besprechen Sprungtermine, Dokumente und mögliche Coaching-Wünsche mit dir.",

    ctaTitle: 'Blauer Himmel und breites Grinsen.',
    ctaSubtitle: 'Wir sehen uns in der Manifest-Schlange.',
    ctaPrimary: "Besuch planen",
    ctaSecondary: 'DZ kontaktieren',
    relatedPricing: 'Mitglieder-, Gast- und Mietpreise ansehen',
  },

  lu: {
    relatedNews: "Neiegkeeten a Veräinsliewen",
    bannerEyebrow: 'Sportsprénger',
    bannerTitle: "Fallschiermsport zu Lëtzebuerg.",
    bannerSubtitle: "Informatiounen iwwer d’Dropzone, Sprongviraussetzungen a Coaching-Kontakter fir lizenzéiert Sprénger zu Noertrange bei Wolz.",

    introEyebrow: 'Über die DZ',
    introTitle: 'Kleine DZ. Großer Himmel.',
    introText: "D’Fluchplaz Noertrange bei Wolz am Norde vu Lëtzebuerg ass d’Doheem vun eisem Fallschiermsveräin. Veräinsmemberen a lizenzéiert Gäscht deelen Trainingsspréng, Coaching an d’Liewen op der Dropzone. Kuck d’Veräinsneiegkeeten a fro eis virun dengem Besuch no Sprongdeeg a Coaching.",

    facEyebrow: 'Einrichtungen',
    facTitle: 'Alles, was du brauchst, vor Ort.',
    facLead: 'Saubere, gut ausgestattete Infrastruktur, damit du dich aufs Springen konzentrieren kannst.',

    cards: [
      { title: 'GA8 Airvan', text: '4 000 m in etwa 20 Minuten, mat 7 Plätzen fir Fallschirmspringer.', image: planeImg, alt: 'GA8 Airvan' },
      { title: 'Material', text: 'Clubmaterial: Next, Firebird, Vector 3 an Omega Systeme, Schirme vu 150 bis 260 sowie Zubehör.', image: packingImg, alt: 'Fallschirmausrüstung der DZ' },
      { title: 'Coaching', text: 'Instrukteren stehen zur Verfügung, wenn du deng Fähigkeiten in verschiedenen Fallschiermsport-Disziplinen weiterentwickeln möchtest. Bitte kontaktiere uns vor dengem Besuch.', image: briefingImg, alt: 'Briefing-Raum' },
      { title: 'Infrastruktur', text: 'Überdachter Packbereich, Video-Briefing an -Debriefing, Bar an Duschen vor Ort.', image: hangarImg, alt: 'Hangar an Veräinsheim' },
    ],

    opsEyebrow: 'Betrieb',
    opsTitle: 'So läuft der Sprongtag ab.',
    opsLead: 'Bitte stelle sicher, dass Lizenz, Versicherung an Dokumente den akzeptierten Anforderungen entsprechen, bevor du zum Springen kommst.',
    opsItems: [
      'Mir springen normalerweise aus 4 000 m; die GA8 Airvan erreicht die Höhe in etwa 20 Minuten.',
      'Fro virun denger Rees no geplangte Sprongdeeg a Veräinsaktivitéiten.',
      "Kontaktéier de Veräin, fir e Sprongdag an d’Umeldung op der Plaz ofzestëmmen. Eng Memberschaft am Veräin ass net néideg; d’Präisser fir Gaaschtspréng gëllen.",
      'Coaching ist in verschiedenen Fallschiermsport-Disziplinen möglich; bitte vorher Kontakt aufnehmen.',
      'Grundsätzlich musst du eine Grundausbildung (AFF oder Static Line) abgeschlossen haben.',
      'Akzeptierte Lizenzen: Lëtzebuergische Fallschirmspringerlizenz; USPA mindestens A Licence; DFV (Deutschland) AFF Ausbildung an mindestens 23 Spréng; FWCP (Belgien) mindestens Brevet A; FFP (Frankreich) mindestens Brevet B.',
      'Bring Lizenz, Sprongbuch, gültige Versicherung an Materialdokumente zum Check-in mit.',
    ],

    formEyebrow: 'Plane dengen Besuch',
    formTitle: 'Vorab anmelden.',
    formText: "Erziel eis am Formulaire vun denger Erfarung an dengem geplangte Besuch als Gaaschtsprénger. Mir schwätze mat dir iwwer Sprongdatumer, Dokumenter a méiglech Coaching-Wënsch.",

    ctaTitle: 'Blauer Himmel an breites Grinsen.',
    ctaSubtitle: 'Mir sehen uns in der Manifest-Schlange.',
    ctaPrimary: "Besuch plangen",
    ctaSecondary: 'DZ kontaktieren',
    relatedPricing: 'Mitglieder-, Gast- an Mietpreise ansehen',
  },
}[lang];

const contactHref = `/${lang}/contact`;
const pricingHref = `/${lang}/pricing`;
const newsHref = `/${lang}/news`;
---

<PageBanner
  image={bannerImg}
  alt="Sport jumpers at the dropzone"
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.introEyebrow}</p>
      <h2 class="section__title">{t.introTitle}</h2>
      <p class="section__lead">{t.introText}</p>
    </header>
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__eyebrow">{t.facEyebrow}</p>
      <h2 class="section__title">{t.facTitle}</h2>
      <p class="section__lead">{t.facLead}</p>
    </header>
    <FeatureCards items={t.cards} cols={2} />
  </div>
</section>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.opsEyebrow}</p>
      <h2 class="section__title">{t.opsTitle}</h2>
      <p class="section__lead">{t.opsLead}</p>
    </header>
    <div class="ops-box">
      <ul>
        {t.opsItems.map((i) => <li>{i}</li>)}
      </ul>
      <p class="related-links">
        <a href={pageHref(pricingHref)}>{t.relatedPricing}</a>
        <a href={pageHref(newsHref)}>{t.relatedNews}</a>
      </p>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="section__inner section__inner--narrow">
    <header class="section__header">
      <p class="section__eyebrow">{t.formEyebrow}</p>
      <h2 class="section__title">{t.formTitle}</h2>
      <p class="section__lead">{t.formText}</p>
    </header>
    <FunJumperForm lang={lang} />
  </div>
</section>

<CTABanner
  title={t.ctaTitle}
  subtitle={t.ctaSubtitle}
  primaryCta={{ label: t.ctaPrimary, href: '#funjumper-form' }}
  secondaryCta={{ label: t.ctaSecondary, href: contactHref }}
/>

<style>
  .ops-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }
  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
  }

  .related-links a {
    font-weight: var(--fw-bold);
  }

  .ops-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ops-box li {
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-fg-muted);
  }
  .ops-box li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-blue);
    font-weight: var(--fw-bold);
  }
</style>
